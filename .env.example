# Hago Auto Ping Bot - Environment Configuration

# === CORE SETTINGS ===
# URL endpoint untuk send ping (required)
HAGO_URL=https://httpbin.org/post

# Room ID yang akan di-ping (required)
HAGO_ROOM_ID=demo-room

# Interval antar ping dalam detik (default: 30)
PING_INTERVAL=30

# === RETRY SETTINGS ===
# Maksimal jumlah retry jika ping gagal (default: 3)
MAX_RETRIES=3

# Exponential backoff factor: wait_time = backoff_factor^(attempt-1) (default: 2.0)
# Contoh: attempt 1 -> 1s, attempt 2 -> 2s, attempt 3 -> 4s
BACKOFF_FACTOR=2.0

# === TIMEOUT SETTINGS ===
# Request timeout dalam detik (default: 10)
TIMEOUT=10

# === DEBUG & LOGGING ===
# Enable debug mode (default: false)
DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# === AUTHENTICATION (OPTIONAL) ===
# Bearer token atau API key jika diperlukan (default: empty)
HAGO_AUTH_TOKEN=

# === NOTES ===
# 1. Copy file ini menjadi .env di root project
# 2. Uncomment dan sesuaikan nilai sesuai kebutuhan
# 3. Gunakan: python -m python-dotenv run python -m app.main
#    atau load manual: from dotenv import load_dotenv; load_dotenv()
