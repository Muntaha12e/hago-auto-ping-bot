# ====================
# Hago API Configuration
# ====================

# Target endpoint URL untuk ping heartbeat
HAGO_URL=https://api.ihago.net/heartbeat

# Room ID / Channel ID untuk di-ping
HAGO_ROOM_ID=C_20453632134829821442_V2_ID_0_ID

# Room token untuk akses room (ambil dari DevTools)
HAGO_ROOM_TOKEN=6Fc5x1mhrD6xHezGGBt83zHgPP_kgN6vFwNwfKDQcpa1pKw

# User ID / UID (ambil dari DevTools)
HAGO_USER_ID=12903446120

# Invite ID (opsional, ambil dari DevTools)
HAGO_INVITE_ID=258161887

# Owner ID (opsional, ambil dari DevTools)
HAGO_OWNER_ID=245862072

# Authorization token jika diperlukan
HAGO_AUTH_TOKEN=Bearer_your_token_here

# ====================
# Ping Service Configuration
# ====================

# Interval ping dalam detik (default: 30)
PING_INTERVAL=30

# Maksimal retry jika request gagal (default: 3)
MAX_RETRIES=3

# Exponential backoff factor untuk retry (default: 2.0)
BACKOFF_FACTOR=2.0

# Request timeout dalam detik (default: 10)
TIMEOUT=10

# ====================
# Logging & Debug
# ====================

# Debug mode (true/false, default: false)
DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# ====================
# Health Check Server
# ====================

# Health check server host (default: 0.0.0.0)
HEALTH_HOST=0.0.0.0

# Health check server port (default: 8080)
HEALTH_PORT=8080
